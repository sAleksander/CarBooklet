---
import Layout from "@/layouts/Layout.astro";
import AppSidebar from "@/components/AppSidebar.astro";
import { MobileSidebarTrigger } from "@/components/MobileSidebarTrigger";
import type { Car } from "@/types";

interface Props {
  title?: string;
  selectedCar?: Car;
}

const { title, selectedCar } = Astro.props;
const pathname = Astro.url.pathname;
const userEmail = Astro.locals.user?.email ?? "";
---

<Layout title={title}>
  <div class="flex h-screen overflow-hidden bg-background">
    <!-- Desktop sidebar -->
    <div class="hidden md:flex">
      <AppSidebar pathname={pathname} userEmail={userEmail} selectedCar={selectedCar} />
    </div>

    <!-- Main column -->
    <div class="flex flex-1 flex-col overflow-hidden">
      <!-- Mobile top bar -->
      <header class="flex items-center gap-3 border-b border-border px-4 py-3 md:hidden">
        <MobileSidebarTrigger
          client:only="react"
          pathname={pathname}
          userEmail={userEmail}
          selectedCar={selectedCar}
          lang={Astro.locals.lang}
          theme={Astro.locals.theme}
        />
        {title && <span class="text-sm font-medium text-muted-foreground">{title}</span>}
      </header>

      <!-- Content area -->
      <main class="flex-1 overflow-auto p-4">
        <slot />
      </main>
    </div>
  </div>
</Layout>
