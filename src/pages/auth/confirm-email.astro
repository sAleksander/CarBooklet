---
import Layout from "@/layouts/Layout.astro";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";

const t = getT(Astro.locals.lang);

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: t("auth.registrationSuccessful"),
      description: t("auth.registrationSuccessDesc"),
      linkText: t("auth.goToSignIn"),
    }
  : {
      emoji: "📧",
      heading: t("auth.checkEmail"),
      description: t("auth.confirmEmailDesc"),
      linkText: t("auth.backToSignIn"),
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center bg-background p-4">
    <div class:list={[surface({ level: "panel" }), "w-full max-w-sm p-8 text-center"]}>
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-bold text-foreground">
        {content.heading}
      </h1>
      <p class="mb-6 text-muted-foreground">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-accent-ink hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
