---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";

const { lang } = Astro.locals;
const t = getT(lang);
const error = Astro.url.searchParams.get("error");
---

<Layout title={t("auth.signIn")}>
  <div class="flex min-h-screen items-center justify-center bg-background p-4">
    <div class:list={[surface({ level: "panel" }), "w-full max-w-sm p-8"]}>
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">
        {t("auth.signIn")}
      </h1>
      <SignInForm serverError={error} lang={lang} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        {t("auth.noAccount")}
        <a href="/auth/signup" class="text-accent-ink hover:underline">{t("auth.signUp")}</a>
      </p>
    </div>
  </div>
</Layout>
