---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";
import { isAuthErrorCode } from "@/lib/auth-errors";

const { lang } = Astro.locals;
const t = getT(lang);
// Allowlisted, then translated — never rendered as it arrived. An unknown
// value resolves to null and the alert box does not render at all, which is
// what closes the phishing surface F8 describes: a crafted link can no longer
// put its own prose inside this card. Same shape as /cars?error=load_failed.
const errorCode = Astro.url.searchParams.get("error");
const error = isAuthErrorCode(errorCode) ? t(`auth.errors.${errorCode}`) : null;
---

<Layout title={t("auth.signIn")}>
  <div class="flex min-h-screen items-center justify-center bg-background p-4">
    <div class:list={[surface({ level: "panel" }), "w-full max-w-sm p-8"]}>
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">
        {t("auth.signIn")}
      </h1>
      <SignInForm serverError={error} lang={lang} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        {t("auth.noAccount")}
        <a href="/auth/signup" class="text-accent-ink hover:underline">{t("auth.signUp")}</a>
      </p>
    </div>
  </div>
</Layout>
