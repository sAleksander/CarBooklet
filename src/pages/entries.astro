---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { logSsrError } from "@/lib/api-errors";
import {
  getRepairEntries,
  getOilChangeEntries,
  getInspectionEntries,
  getInsuranceEntries,
} from "@/lib/services/entries";
import { EntriesTabs } from "@/components/entries/EntriesTabs";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";

const { selectedCarId, user, lang } = Astro.locals;
const t = getT(lang);

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

let car;
try {
  car = await getCarById(supabase, selectedCarId, user.id);
} catch (err) {
  logSsrError(err, { route: "/entries", method: "GET", userId: user.id });
  return Astro.redirect("/cars?error=load_failed");
}

if (car?.user_id !== user.id) {
  return Astro.redirect("/cars");
}

let initialRepairEntries, initialOilChangeEntries, initialInspectionEntries, initialInsuranceEntries;
try {
  [initialRepairEntries, initialOilChangeEntries, initialInspectionEntries, initialInsuranceEntries] =
    await Promise.all([
      getRepairEntries(supabase, selectedCarId, user.id),
      getOilChangeEntries(supabase, selectedCarId, user.id),
      getInspectionEntries(supabase, selectedCarId, user.id),
      getInsuranceEntries(supabase, selectedCarId, user.id),
    ]);
} catch (err) {
  logSsrError(err, { route: "/entries", method: "GET", userId: user.id });
  return Astro.redirect("/cars?error=load_failed");
}
---

<AppLayout title={`${car.brand} ${car.model} — ${t("entries.serviceHistory")}`} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class:list={[surface({ level: "panel" }), "w-full max-w-2xl p-8"]}>
      <h1 class="mb-2 text-2xl font-bold text-foreground">
        {car.brand}
        {car.model}
      </h1>
      <p class="mb-8 text-sm text-muted-foreground">{t("entries.serviceHistory")}</p>
      <EntriesTabs
        initialRepairEntries={initialRepairEntries}
        initialOilChangeEntries={initialOilChangeEntries}
        initialInspectionEntries={initialInspectionEntries}
        initialInsuranceEntries={initialInsuranceEntries}
        carId={selectedCarId}
        lang={lang}
        client:load
      />
    </div>
  </div>
</AppLayout>
