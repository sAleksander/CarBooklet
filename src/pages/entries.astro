---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import {
  getRepairEntries,
  getOilChangeEntries,
  getInspectionEntries,
  getInsuranceEntries,
} from "@/lib/services/entries";
import { EntriesTabs } from "@/components/entries/EntriesTabs";

const { selectedCarId, user } = Astro.locals;

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

const [car, initialRepairEntries, initialOilChangeEntries, initialInspectionEntries, initialInsuranceEntries] =
  await Promise.all([
    getCarById(supabase, selectedCarId, user.id),
    getRepairEntries(supabase, selectedCarId, user.id),
    getOilChangeEntries(supabase, selectedCarId, user.id),
    getInspectionEntries(supabase, selectedCarId, user.id),
    getInsuranceEntries(supabase, selectedCarId, user.id),
  ]);

if (car?.user_id !== user.id) {
  return Astro.redirect("/cars");
}
---

<AppLayout title={`${car.brand} ${car.model} — Entries`} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {car.brand}
        {car.model}
      </h1>
      <p class="mb-8 text-sm text-blue-100/60">Service history</p>
      <EntriesTabs
        initialRepairEntries={initialRepairEntries}
        initialOilChangeEntries={initialOilChangeEntries}
        initialInspectionEntries={initialInspectionEntries}
        initialInsuranceEntries={initialInsuranceEntries}
        carId={selectedCarId}
        client:load
      />
    </div>
  </div>
</AppLayout>
