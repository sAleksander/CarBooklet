---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getRepairEntries } from "@/lib/services/entries";
import { RepairEntries } from "@/components/entries/RepairEntries";

const { selectedCarId, user } = Astro.locals;

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

const [car, initialEntries] = await Promise.all([
  getCarById(supabase, selectedCarId),
  getRepairEntries(supabase, selectedCarId, user.id),
]);

if (!car) {
  return Astro.redirect("/cars");
}
---

<Layout title={`${car.brand} ${car.model} — Repair Entries`}>
  <div class="bg-cosmic min-h-screen p-4">
    <Topbar />
    <div class="flex justify-center pt-8">
      <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          {car.brand}
          {car.model}
        </h1>
        <p class="mb-8 text-sm text-blue-100/60">Repair entries</p>
        <RepairEntries initialEntries={initialEntries} carId={selectedCarId} client:load />
      </div>
    </div>
  </div>
</Layout>
