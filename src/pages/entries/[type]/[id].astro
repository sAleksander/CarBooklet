---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryDetail from "@/components/entries/EntryDetail.astro";
import { EntryDetailEditor } from "@/components/entries/EntryDetailEditor";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getEntryById } from "@/lib/services/entries";
import { logSsrError } from "@/lib/api-errors";
import { getT } from "@/i18n/server";
import type { Entry, Car } from "@/types";
import { surface } from "@/lib/theme";

const { type, id } = Astro.params;
const { selectedCarId, user, lang } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const t = getT(lang);

const validTypes = ["repair", "oil_change", "inspection", "insurance"] as const;
type ValidType = (typeof validTypes)[number];

if (!type || !id || !selectedCarId || !supabase || !user || !(validTypes as readonly string[]).includes(type)) {
  return Astro.redirect("/cars");
}

const entryType = type as ValidType;

let rawEntry: Entry | null;
try {
  rawEntry = await getEntryById(supabase, entryType, id, user.id);
} catch (err) {
  logSsrError(err, { route: "/entries/[type]/[id]", method: "GET", userId: user.id });
  return Astro.redirect("/cars?error=load_failed");
}

let entry: Entry | null = null;
let car: Car | undefined;

if (rawEntry?.car_id !== selectedCarId) {
  Astro.response.status = 404;
} else {
  entry = rawEntry;
  try {
    const fetchedCar = await getCarById(supabase, selectedCarId, user.id);
    if (fetchedCar?.user_id !== user.id) return Astro.redirect("/cars");
    car = fetchedCar;
  } catch (err) {
    logSsrError(err, { route: "/entries/[type]/[id]", method: "GET", userId: user.id });
    return Astro.redirect("/cars?error=load_failed");
  }
}

const entryTypeLabel: Record<string, string> = {
  repair: t("entries.types.repair"),
  oil_change: t("entries.types.oil_change"),
  inspection: t("entries.types.inspection"),
  insurance: t("entries.types.insurance"),
};

const title = entry && car ? `${entryTypeLabel[entryType]} — ${car.brand} ${car.model}` : t("entries.detail.notFound");
---

<AppLayout title={title} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-2xl">
      {
        !entry ? (
          <div class:list={[surface({ level: "panel" }), "p-8 text-center"]}>
            <h1 class="mb-2 text-xl font-bold text-foreground">{t("entries.detail.notFound")}</h1>
            <p class="mb-6 text-sm text-muted-foreground">{t("entries.detail.notFoundDesc")}</p>
            <a
              href="/entries"
              class="inline-flex items-center gap-1 text-sm text-accent-ink transition-colors hover:underline"
            >
              {t("entries.detail.backToEntries")}
            </a>
          </div>
        ) : (
          <div class:list={[surface({ level: "panel" }), "p-8"]}>
            <div class="mb-6 flex items-center justify-between">
              <div>
                <h1 class="text-2xl font-bold text-foreground">{entryTypeLabel[entryType]}</h1>
                {car && (
                  <p class="mt-1 text-sm text-muted-foreground">
                    {car.brand} {car.model}
                  </p>
                )}
              </div>
              <a href="/entries" class="text-sm text-accent-ink transition-colors hover:underline">
                {t("entries.detail.backToEntries")}
              </a>
            </div>
            <EntryDetailEditor entry={entry} lang={lang} client:load>
              <EntryDetail entry={entry} />
            </EntryDetailEditor>
          </div>
        )
      }
    </div>
  </div>
</AppLayout>
