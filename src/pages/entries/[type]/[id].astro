---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryDetail from "@/components/entries/EntryDetail.astro";
import { EntryDetailEditor } from "@/components/entries/EntryDetailEditor";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getEntryById } from "@/lib/services/entries";
import type { Entry, Car } from "@/types";

const { type, id } = Astro.params;
const { selectedCarId, user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

const validTypes = ["repair", "oil_change", "inspection", "insurance"] as const;
type ValidType = (typeof validTypes)[number];

if (!type || !id || !selectedCarId || !supabase || !user || !(validTypes as readonly string[]).includes(type)) {
  return Astro.redirect("/cars");
}

const entryType = type as ValidType;

let rawEntry: Entry | null;
try {
  rawEntry = await getEntryById(supabase, entryType, id, user.id);
} catch {
  return Astro.redirect("/cars?error=load_failed");
}

let entry: Entry | null = null;
let car: Car | undefined;

if (rawEntry?.car_id !== selectedCarId) {
  Astro.response.status = 404;
} else {
  entry = rawEntry;
  try {
    const fetchedCar = await getCarById(supabase, selectedCarId, user.id);
    if (fetchedCar?.user_id !== user.id) return Astro.redirect("/cars");
    car = fetchedCar;
  } catch {
    return Astro.redirect("/cars?error=load_failed");
  }
}

const entryTypeLabel: Record<string, string> = {
  repair: "Repair",
  oil_change: "Oil Change",
  inspection: "Inspection",
  insurance: "Insurance",
};

const title = entry && car ? `${entryTypeLabel[entryType]} — ${car.brand} ${car.model}` : "Entry not found";
---

<AppLayout title={title} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-2xl">
      {
        !entry ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-2 text-xl font-bold text-white/80">Entry not found</h1>
            <p class="mb-6 text-sm text-blue-100/60">This entry doesn't exist or belongs to a different car.</p>
            <a
              href="/entries"
              class="inline-flex items-center gap-1 text-sm text-blue-300 transition-colors hover:text-blue-200"
            >
              ← Back to entries
            </a>
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
            <div class="mb-6 flex items-center justify-between">
              <div>
                <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
                  {entryTypeLabel[entryType]}
                </h1>
                {car && (
                  <p class="mt-1 text-sm text-blue-100/60">
                    {car.brand} {car.model}
                  </p>
                )}
              </div>
              <a href="/entries" class="text-sm text-blue-300 transition-colors hover:text-blue-200">
                ← Back to entries
              </a>
            </div>
            <EntryDetailEditor entry={entry} client:load>
              <EntryDetail entry={entry} />
            </EntryDetailEditor>
          </div>
        )
      }
    </div>
  </div>
</AppLayout>
