---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryDetail from "@/components/entries/EntryDetail.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getEntryById } from "@/lib/services/entries";

const { id } = Astro.params;
const { selectedCarId, user } = Astro.locals;

if (!id || !selectedCarId || !user) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase) {
  return Astro.redirect("/cars");
}

let entry;
try {
  entry = await getEntryById(supabase, id, user.id);
} catch {
  return Astro.redirect("/cars?error=load_failed");
}

if (entry?.car_id !== selectedCarId) {
  Astro.response.status = 404;
}

let car;
if (entry?.car_id === selectedCarId) {
  try {
    car = await getCarById(supabase, selectedCarId, user.id);
  } catch {
    return Astro.redirect("/cars?error=load_failed");
  }
}

const entryTypeLabel: Record<string, string> = {
  repair: "Repair",
  oil_change: "Oil Change",
  inspection: "Inspection",
  insurance: "Insurance",
};

const title = entry && car ? `${entryTypeLabel[entry.entry_type]} — ${car.brand} ${car.model}` : "Entry not found";
---

<AppLayout title={title} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-2xl">
      {
        entry?.car_id !== selectedCarId ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="mb-2 text-xl font-bold text-white/80">Entry not found</h1>
            <p class="mb-6 text-sm text-blue-100/60">This entry doesn't exist or belongs to a different car.</p>
            <a
              href="/entries"
              class="inline-flex items-center gap-1 text-sm text-blue-300 transition-colors hover:text-blue-200"
            >
              ← Back to entries
            </a>
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
            <div class="mb-6 flex items-center justify-between">
              <div>
                <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
                  {entryTypeLabel[entry.entry_type]}
                </h1>
                {car && (
                  <p class="mt-1 text-sm text-blue-100/60">
                    {car.brand} {car.model}
                  </p>
                )}
              </div>
              <a href="/entries" class="text-sm text-blue-300 transition-colors hover:text-blue-200">
                ← Back to entries
              </a>
            </div>
            <EntryDetail entry={entry} />
          </div>
        )
      }
    </div>
  </div>
</AppLayout>
