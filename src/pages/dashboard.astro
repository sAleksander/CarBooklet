---
import AppLayout from "@/layouts/AppLayout.astro";
import DeadlineCard from "@/components/DeadlineCard.astro";
import LastEntryCard from "@/components/LastEntryCard.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getCarDeadlines, getLastEntry } from "@/lib/services/entries";
import { logSsrError } from "@/lib/api-errors";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";

const { user, selectedCarId, lang } = Astro.locals;
const t = getT(lang);

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

let car;
let deadlines;
let lastEntry;
try {
  [car, deadlines, lastEntry] = await Promise.all([
    getCarById(supabase, selectedCarId, user.id),
    getCarDeadlines(supabase, selectedCarId, user.id),
    getLastEntry(supabase, selectedCarId, user.id),
  ]);
} catch (err) {
  logSsrError(err, { route: "/dashboard", method: "GET", userId: user.id });
  return Astro.redirect("/cars?error=load_failed");
}

if (car?.user_id !== user.id) {
  return Astro.redirect("/cars");
}
---

<AppLayout title={`${t("nav.dashboard")} — ${car.brand} ${car.model}`} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-3xl">
      <div class:list={[surface({ level: "panel" }), "mb-8 px-8 py-6"]}>
        <h1 class="mb-1 text-2xl font-bold text-foreground">
          {car.brand}
          {car.model}
        </h1>
        <p class="text-sm text-muted-foreground">{car.production_year}</p>
        <a href="/cars" class="mt-3 inline-block text-sm text-accent-ink underline-offset-2 hover:underline">
          {t("dashboard.changeCar")}
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <DeadlineCard title={t("dashboard.oilChange")} status={deadlines.oilChange.status}>
          {
            deadlines.oilChange.status === "no_data" ? (
              <p class="text-sm text-muted-foreground">{t("dashboard.noOilChange")}</p>
            ) : (
              <div class="space-y-1 text-sm">
                <p class="text-muted-foreground">
                  {t("dashboard.last")}{" "}
                  <span class="font-medium text-foreground">{deadlines.oilChange.lastConductedAt}</span>
                </p>
                <p class="text-muted-foreground">
                  {t("dashboard.nextDue")}{" "}
                  <span class="font-medium text-foreground">{deadlines.oilChange.nextDueDate}</span>
                </p>
                {deadlines.oilChange.nextDueMileage !== null && (
                  <p class="text-muted-foreground">
                    {t("dashboard.orAtKm", { value: deadlines.oilChange.nextDueMileage.toLocaleString() })}
                  </p>
                )}
              </div>
            )
          }
        </DeadlineCard>

        <DeadlineCard title={t("dashboard.inspection")} status={deadlines.inspection.status}>
          {
            deadlines.inspection.status === "no_data" ? (
              <p class="text-sm text-muted-foreground">{t("dashboard.noInspection")}</p>
            ) : deadlines.inspection.status === "no_next_date" ? (
              <div class="space-y-1 text-sm">
                <p class="text-muted-foreground">
                  {t("dashboard.last")}{" "}
                  <span class="font-medium text-foreground">{deadlines.inspection.lastConductedAt}</span>
                </p>
                <p class="text-muted-foreground">{t("dashboard.nextDateNotSet")}</p>
              </div>
            ) : (
              <p class="text-sm text-muted-foreground">
                {t("dashboard.nextInspection")}{" "}
                <span class="font-medium text-foreground">{deadlines.inspection.nextInspectionDate}</span>
              </p>
            )
          }
        </DeadlineCard>

        <DeadlineCard title={t("dashboard.insurance")} status={deadlines.insurance.status}>
          {
            deadlines.insurance.status === "no_data" ? (
              <p class="text-sm text-muted-foreground">{t("dashboard.noInsurance")}</p>
            ) : (
              <div class="space-y-1 text-sm">
                <p class="text-muted-foreground">
                  {t("dashboard.renewal")}{" "}
                  <span class="font-medium text-foreground">{deadlines.insurance.renewalDate}</span>
                </p>
                {deadlines.insurance.insurer && <p class="text-muted-foreground">{deadlines.insurance.insurer}</p>}
              </div>
            )
          }
        </DeadlineCard>
      </div>

      {
        lastEntry && (
          <div class="mt-4">
            <LastEntryCard entry={lastEntry} />
          </div>
        )
      }
    </div>
  </div>
</AppLayout>
