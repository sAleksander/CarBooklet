---
import AppLayout from "@/layouts/AppLayout.astro";
import DeadlineCard from "@/components/DeadlineCard.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { getCarDeadlines } from "@/lib/services/entries";

const { user, selectedCarId } = Astro.locals;

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

const car = await getCarById(supabase, selectedCarId, user.id);

if (car?.user_id !== user.id) {
  return Astro.redirect("/cars");
}

let deadlines;
try {
  deadlines = await getCarDeadlines(supabase, selectedCarId, user.id);
} catch {
  return Astro.redirect("/cars?error=load_failed");
}
---

<AppLayout title={`Dashboard — ${car.brand} ${car.model}`} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-3xl">
      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 px-8 py-6 text-white backdrop-blur-xl">
        <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          {car.brand}
          {car.model}
        </h1>
        <p class="text-sm text-blue-100/60">{car.production_year}</p>
        <a
          href="/cars"
          class="mt-3 inline-block text-sm text-blue-200/70 underline-offset-2 hover:text-blue-200 hover:underline"
        >
          Change car
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <DeadlineCard title="Oil Change" status={deadlines.oilChange.status}>
          {
            deadlines.oilChange.status === "no_data" ? (
              <p class="text-sm text-blue-100/50">No oil change entries logged.</p>
            ) : (
              <div class="space-y-1 text-sm">
                <p class="text-blue-100/70">
                  Last: <span class="font-medium text-white">{deadlines.oilChange.lastConductedAt}</span>
                </p>
                <p class="text-blue-100/70">
                  Next due: <span class="font-medium text-white">{deadlines.oilChange.nextDueDate}</span>
                </p>
                {deadlines.oilChange.nextDueMileage !== null && (
                  <p class="text-blue-100/50">or at ~{deadlines.oilChange.nextDueMileage.toLocaleString()} km</p>
                )}
              </div>
            )
          }
        </DeadlineCard>

        <DeadlineCard title="Inspection" status={deadlines.inspection.status}>
          {
            deadlines.inspection.status === "no_data" ? (
              <p class="text-sm text-blue-100/50">No inspection entries logged.</p>
            ) : deadlines.inspection.status === "no_next_date" ? (
              <div class="space-y-1 text-sm">
                <p class="text-blue-100/70">
                  Last: <span class="font-medium text-white">{deadlines.inspection.lastConductedAt}</span>
                </p>
                <p class="text-blue-100/50">Next date not set.</p>
              </div>
            ) : (
              <p class="text-sm text-blue-100/70">
                Next inspection: <span class="font-medium text-white">{deadlines.inspection.nextInspectionDate}</span>
              </p>
            )
          }
        </DeadlineCard>

        <DeadlineCard title="Insurance" status={deadlines.insurance.status}>
          {
            deadlines.insurance.status === "no_data" ? (
              <p class="text-sm text-blue-100/50">No insurance entries logged.</p>
            ) : (
              <div class="space-y-1 text-sm">
                <p class="text-blue-100/70">
                  Renewal: <span class="font-medium text-white">{deadlines.insurance.renewalDate}</span>
                </p>
                {deadlines.insurance.insurer && <p class="text-blue-100/50">{deadlines.insurance.insurer}</p>}
              </div>
            )
          }
        </DeadlineCard>
      </div>
    </div>
  </div>
</AppLayout>
