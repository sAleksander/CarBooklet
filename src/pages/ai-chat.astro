---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { getCarById } from "@/lib/services/cars";
import { ChatDemo } from "@/components/ai/ChatDemo";
import { getT } from "@/i18n/server";

const { selectedCarId, user, lang } = Astro.locals;
const t = getT(lang);

if (!selectedCarId) {
  return Astro.redirect("/cars");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  return Astro.redirect("/cars");
}

const car = await getCarById(supabase, selectedCarId, user.id);

if (car?.user_id !== user.id) {
  return Astro.redirect("/cars");
}
---

<AppLayout title={t("nav.aiChat")} selectedCar={car}>
  <div class="flex justify-center pt-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {car.brand}
        {car.model}
        — {t("nav.aiChat")}
      </h1>
      <p class="mb-8 text-sm text-blue-100/60">{car.production_year}</p>
      <ChatDemo lang={lang} client:load />
    </div>
  </div>
</AppLayout>
