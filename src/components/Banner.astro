---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<!--
  The app's only plain-CSS component, so it is the one file no utility sweep and no
  grep over class attributes will ever reach. It therefore references the custom
  properties directly. This is the same three-part recipe the utilities express as
  `border-status-*` / `text-status-*-ink` / `bg-status-*\/10`, written longhand:
  the bare token is the BORDER (>=3:1), the `-ink` token is the TEXT (>=4.5:1), and
  the surface is a 10% mix of the bare token. Because they are `var()` references,
  all three variants follow the theme with no `.dark` block here.
-->
<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: color-mix(in oklab, var(--status-info) 10%, transparent);
    color: var(--status-info-ink);
    border-color: var(--status-info);
  }
  .banner--warning {
    background: color-mix(in oklab, var(--status-warn) 10%, transparent);
    color: var(--status-warn-ink);
    border-color: var(--status-warn);
  }
  .banner--error {
    background: color-mix(in oklab, var(--status-bad) 10%, transparent);
    color: var(--status-bad-ink);
    border-color: var(--status-bad);
  }
</style>
