---
import { getT } from "@/i18n/server";
import type { Entry } from "@/types";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const t = getT(Astro.locals.lang);

const dash = "—";

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return dash;
  return new Date(dateStr).toLocaleDateString();
}
---

<div class="space-y-6">
  <!-- Common fields -->
  <div class="grid grid-cols-2 gap-4">
    <div>
      <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">
        {entry.entry_type === "insurance" ? t("entries.detail.policyStartLabel") : t("entries.detail.date")}
      </p>
      <p class="mt-1 text-sm text-white">
        {
          entry.entry_type === "insurance"
            ? formatDate(entry.policy_start_date ?? entry.renewal_date)
            : formatDate(entry.conducted_at)
        }
      </p>
    </div>
    <div>
      <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.mileage")}</p>
      <p class="mt-1 text-sm text-white">
        {entry.mileage !== null ? `${entry.mileage.toLocaleString()} km` : dash}
      </p>
    </div>
  </div>

  <hr class="border-white/10" />

  <!-- Type-specific fields -->
  {
    entry.entry_type === "repair" && (
      <div class="space-y-4">
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.description")}</p>
          <p class="mt-1 text-sm whitespace-pre-wrap text-white">{entry.description || dash}</p>
        </div>
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.cause")}</p>
          <p class="mt-1 text-sm whitespace-pre-wrap text-white">{entry.cause ?? dash}</p>
        </div>
      </div>
    )
  }

  {
    entry.entry_type === "oil_change" && (
      <div>
        <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.oilDetails")}</p>
        <p class="mt-1 text-sm whitespace-pre-wrap text-white">{entry.oil_details ?? dash}</p>
      </div>
    )
  }

  {
    entry.entry_type === "inspection" && (
      <div class="space-y-4">
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.result")}</p>
          <p class="mt-1 text-sm text-white">
            {entry.result === "Passed"
              ? t("entries.results.passed")
              : entry.result === "Failed"
                ? t("entries.results.failed")
                : dash}
          </p>
        </div>
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">
            {t("entries.detail.nextInspectionDate")}
          </p>
          <p class="mt-1 text-sm text-white">{formatDate(entry.next_inspection_date)}</p>
        </div>
      </div>
    )
  }

  {
    entry.entry_type === "insurance" && (
      <div class="space-y-4">
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.insurer")}</p>
          <p class="mt-1 text-sm text-white">{entry.insurer ?? dash}</p>
        </div>
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">
            {t("entries.detail.policyStartDate")}
          </p>
          <p class="mt-1 text-sm text-white">{formatDate(entry.policy_start_date)}</p>
        </div>
        <div>
          <p class="text-xs font-medium tracking-wide text-blue-100/60 uppercase">{t("entries.detail.renewalDate")}</p>
          <p class="mt-1 text-sm text-white">{formatDate(entry.renewal_date)}</p>
        </div>
      </div>
    )
  }

  <!-- Metadata footer -->
  <hr class="border-white/10" />
  <p class="text-xs text-blue-100/40">
    {t("entries.detail.loggedOn")}
    {formatDate(entry.created_at)}
    {
      entry.updated_at !== entry.created_at && (
        <span>
          {" "}
          · {t("entries.detail.updated")} {formatDate(entry.updated_at)}
        </span>
      )
    }
  </p>
</div>
