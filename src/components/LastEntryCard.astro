---
import type { Entry } from "@/types";
import { getT } from "@/i18n/server";
import { surface } from "@/lib/theme";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const t = getT(Astro.locals.lang);

const dash = "—";

let summary: string;
switch (entry.entry_type) {
  case "repair":
    summary = entry.description || dash;
    break;
  case "oil_change":
    summary = entry.oil_details ?? dash;
    break;
  case "inspection":
    if (entry.result === "Passed") {
      summary = t("entries.results.passed");
    } else if (entry.result === "Failed") {
      summary = t("entries.results.failed");
    } else {
      summary = dash;
    }
    break;
  case "insurance":
    summary = entry.insurer ?? dash;
    break;
}
---

<a
  href={`/entries/${entry.entry_type}/${entry.id}`}
  class:list={[surface({ level: "panel" }), "block p-6 transition-colors hover:bg-accent"]}
>
  <p class="mb-3 text-xs font-semibold tracking-wide text-muted-foreground uppercase">{t("dashboard.lastEntry")}</p>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-foreground">{t(`entries.types.${entry.entry_type}`)}</p>
      <p class="mt-0.5 truncate text-sm text-muted-foreground" title={summary}>{summary}</p>
    </div>
    <p class="shrink-0 text-sm text-muted-foreground">{new Date(entry.conducted_at).toLocaleDateString()}</p>
  </div>
</a>
