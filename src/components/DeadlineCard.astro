---
import type { DeadlineStatus } from "@/types";
import { statusSurface, statusDot, toneForDeadline } from "@/lib/theme";

interface Props {
  title: string;
  status: DeadlineStatus;
}

const { title, status } = Astro.props;

// The DB speaks in colour names ("red" | "yellow" | "green"); the palette speaks
// in tones. Translating at this boundary is what let the warning state move off
// Renault yellow without touching src/types.ts or the service layer.
const tone = toneForDeadline(status);
---

<div class:list={[statusSurface({ tone }), "p-5"]}>
  <div class="mb-3 flex items-center gap-2">
    <span class:list={statusDot({ tone })}></span>
    <h2 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">{title}</h2>
  </div>
  <slot />
</div>
