---
import { NAV_ITEMS } from "@/lib/nav";
import { getT } from "@/i18n/server";
import type { Car } from "@/types";

interface Props {
  pathname: string;
  userEmail: string;
  selectedCar?: Car;
}

const { pathname, userEmail, selectedCar } = Astro.props;
const t = getT(Astro.locals.lang);
const lang = Astro.locals.lang;
const theme = Astro.locals.theme;
---

<aside class="flex h-full w-60 flex-shrink-0 flex-col border-r border-sidebar-border bg-sidebar">
  <!-- Car switcher -->
  <div class="border-b border-sidebar-border p-4">
    <a
      href="/cars"
      class="flex w-full items-center rounded-lg border border-sidebar-border bg-sidebar-accent/60 px-3 py-2 text-sm transition-colors hover:bg-sidebar-accent"
    >
      {
        selectedCar ? (
          <span class="truncate text-sidebar-foreground">
            {selectedCar.brand} {selectedCar.model}
          </span>
        ) : (
          <span class="text-sidebar-muted-foreground">{t("sidebar.selectACar")}</span>
        )
      }
    </a>
  </div>

  <!-- Nav list -->
  <nav class="flex-1 space-y-1 p-3">
    {
      NAV_ITEMS.map((item) => {
        const isActive = pathname === item.href || pathname.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class:list={[
              "block rounded-lg px-3 py-2 text-sm font-medium transition-colors",
              isActive ? "bg-sidebar-accent text-sidebar-primary" : "text-sidebar-foreground hover:bg-sidebar-accent",
            ].join(" ")}
          >
            {t(item.labelKey)}
          </a>
        );
      })
    }
  </nav>

  <!-- Footer -->
  <div class="border-t border-sidebar-border p-4">
    <p class="mb-3 truncate text-xs text-sidebar-muted-foreground">{userEmail}</p>

    <!-- Language toggle -->
    <div class="mb-3 flex gap-1" role="group" aria-label={t("sidebar.language")}>
      <form method="POST" action="/api/lang/en">
        <button
          type="submit"
          aria-pressed={lang === "en"}
          class:list={[
            "rounded px-2 py-0.5 text-xs font-medium transition-colors",
            lang === "en"
              ? "bg-sidebar-accent text-sidebar-primary"
              : "text-sidebar-muted-foreground hover:text-sidebar-foreground",
          ].join(" ")}
        >
          {t("sidebar.langEn")}
        </button>
      </form>
      <form method="POST" action="/api/lang/pl">
        <button
          type="submit"
          aria-pressed={lang === "pl"}
          class:list={[
            "rounded px-2 py-0.5 text-xs font-medium transition-colors",
            lang === "pl"
              ? "bg-sidebar-accent text-sidebar-primary"
              : "text-sidebar-muted-foreground hover:text-sidebar-foreground",
          ].join(" ")}
        >
          {t("sidebar.langPl")}
        </button>
      </form>
    </div>

    <!-- Theme toggle. No onClick and no preventDefault: a plain form POST
         full-reloads, which is how the locale switch already works.

         aria-pressed carries the active state: the visual signal is a
         background wash plus a hue shift, which is colour alone. -->
    <div class="mb-3 flex gap-1" role="group" aria-label={t("sidebar.theme")}>
      <form method="POST" action="/api/theme/light">
        <button
          type="submit"
          aria-pressed={theme === "light"}
          class:list={[
            "rounded px-2 py-0.5 text-xs font-medium transition-colors",
            theme === "light"
              ? "bg-sidebar-accent text-sidebar-primary"
              : "text-sidebar-muted-foreground hover:text-sidebar-foreground",
          ].join(" ")}
        >
          {t("sidebar.themeLight")}
        </button>
      </form>
      <form method="POST" action="/api/theme/dark">
        <button
          type="submit"
          aria-pressed={theme === "dark"}
          class:list={[
            "rounded px-2 py-0.5 text-xs font-medium transition-colors",
            theme === "dark"
              ? "bg-sidebar-accent text-sidebar-primary"
              : "text-sidebar-muted-foreground hover:text-sidebar-foreground",
          ].join(" ")}
        >
          {t("sidebar.themeDark")}
        </button>
      </form>
      <form method="POST" action="/api/theme/system">
        <button
          type="submit"
          aria-pressed={theme === "system"}
          class:list={[
            "rounded px-2 py-0.5 text-xs font-medium transition-colors",
            theme === "system"
              ? "bg-sidebar-accent text-sidebar-primary"
              : "text-sidebar-muted-foreground hover:text-sidebar-foreground",
          ].join(" ")}
        >
          {t("sidebar.themeSystem")}
        </button>
      </form>
    </div>

    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="text-sm text-sidebar-muted-foreground transition-colors hover:text-sidebar-foreground"
      >
        {t("sidebar.signOut")}
      </button>
    </form>
  </div>
</aside>
