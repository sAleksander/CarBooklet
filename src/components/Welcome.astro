---
import { getT } from "@/i18n/server";

const t = getT(Astro.locals.lang);
---

<!--
  The three blurred "cosmic orbs" and the translucent-white star field that used to live here
  were light-emitting shapes on a black ground — dark-only by construction, with no
  token equivalent, because there is no token for "decoration". They are deleted
  rather than re-themed. The hero follows the theme like every other surface, and
  carries the brand through the yellow CTA instead of through background effects.
-->
<div class="min-h-screen w-full bg-background">
  <div class="p-4 sm:p-8">
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-6 text-5xl leading-tight font-bold text-foreground sm:text-6xl lg:text-7xl">
        {t("landing.title")}
      </h1>
      <p class="mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
        {t("landing.subtitle")}
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          {t("landing.signIn")}
        </a>
        <!-- border-input, not border-border: this is an interactive control, so the
             outline needs 3:1 (WCAG 1.4.11), which the decorative hairline misses. -->
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-lg border border-input px-6 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent"
        >
          {t("landing.signUp")}
        </a>
      </div>
    </div>
  </div>
</div>
