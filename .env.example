SUPABASE_URL=###
SUPABASE_KEY=###
OPENROUTER_API_KEY=###

# Required by BOTH test suites — `npm run test:integration` and `npm run test:e2e`.
# The integration suite's globalSetup fails the whole project without it.
# The service_role key from `npx supabase status`.
# Bypasses RLS: it seeds and deletes test users. Keep it out of src/, and point
# it at the LOCAL stack, never a cloud project.
SUPABASE_SERVICE_ROLE_KEY=###
